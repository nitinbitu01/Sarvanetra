# .dockerignore — keep the image lean
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Dev / test artifacts
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.log
reports/
evidence/
output/
hls/
data/

# Version control
.git/
.gitignore

# Environment files — NEVER bake into image
.env
.env.*
*.env

# Node / frontend (built separately)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/

# Large model weights — mount via volume at runtime
*.onnx
*.pt
*.pth
*.weights

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
