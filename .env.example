# Sentinel Gujarat — Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
ENV=dev                          # dev | staging | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default):
DATABASE_URL=sqlite:///./output/sentinel.db
# PostgreSQL (Day 13+): uncomment and fill in when ready
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sentinel

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60        # General routes (per IP)
AUTH_RATE_LIMIT_PER_MINUTE=10   # /auth/login (brute-force protection)

# ── Behavior engine — Day 8 ────────────────────────────────────────────────────
# Redis backend for loitering/crowd detector state (survives restarts).
# The app still runs without Redis — the behavior engine just skips-and-logs
# each tick instead of crashing. See backend/services/state.py.
REDIS_URL=redis://localhost:6379/0

# ── Retention policy — Day 9 ─────────────────────────────────────────────
# PLACEHOLDER VALUES — confirm with compliance before go-live (DPDP Act,
# MHA guidelines, applicable State police IT policy).
JOURNEY_RETENTION_DAYS=30        # journey rows hard-deleted after this many days
AUDIT_RETENTION_DAYS=365         # journey_query_log rows kept for 1 year

# ── Abandoned-object detector — Day 9 ──────────────────────────────────
# Re-run tests/abandoned_object_eval/eval_runner.py after changing any of these.
OWNERSHIP_RADIUS_METERS=2.0      # owner must stay within this radius of object
ABANDON_DURATION_SEC=60.0        # object must be unattended this long before alert
STATIC_MOVEMENT_PX_THRESHOLD=10.0  # max centroid drift (px) for 'static' classification

# ── Demo Mode Configuration — Day 19 ────────────────────────────────────────
DEMO_MODE=True
SENTINEL_DEMO_MODE=True
ACK_TIMEOUT_SECONDS=15
PTZ_RECOVERY_ETA_SECONDS=10
LOITERING_THRESHOLD_SECONDS=8
